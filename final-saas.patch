-DECLARE
-  v_empresa_id uuid;
-  v_nome_empresa text;
-  v_nome text;
-BEGIN
-  v_nome := COALESCE(NEW.raw_user_meta_data->>'nome', split_part(NEW.email, '@', 1));
-  v_nome_empresa := COALESCE(NEW.raw_user_meta_data->>'empresa', v_nome || ' - Comércio');
